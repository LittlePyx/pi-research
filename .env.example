# OpenAI Responses API (server-side only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional server-side key. Anonymous access still works, while an individual
# Semantic Scholar key provides a more predictable request allowance.
SEMANTIC_SCHOLAR_API_KEY=

# Development only: remove total retry and daily analysis caps while retaining
# provider backoff, request timeouts, durable checkpoints, and quality gates.
PI_DEVELOPMENT_UNBOUNDED=1

# Daily digest mail: site administrator only. Never expose these to the browser.
# Use a Resend sending key and a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SITE_URL=https://pi-research-agent.qiudao-pika.chatgpt.site
